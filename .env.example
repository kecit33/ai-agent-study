# 智能体提供商 API 密钥（按需填写，未填写的厂商自动使用内置演示模式）
# 复制本文件为 .env 并填入你的密钥；也可不改文件，直接在 Web「设置 → 模型接入」里填，
# 或调用 POST /api/agent/credentials 运行时写入（立即生效、无需重启）。

# 默认激活的提供商：demo / openai / qianfan / moonshot / claude / custom
ACTIVE_PROVIDER=demo

# OpenAI (GPT)
OPENAI_API_KEY=
OPENAI_MODEL=gpt-3.5-turbo
OPENAI_BASE_URL=https://api.openai.com/v1/chat/completions

# 百度文心一言 (QianFan / ERNIE)
# 方式 A（推荐·千帆 v2，只需 API Key）：QIANFAN_BASE_URL 填 v2 地址
# 方式 B（旧版 WenxinWorkshop）：同时填 API Key + Secret Key
QIANFAN_API_KEY=
QIANFAN_SECRET_KEY=
QIANFAN_MODEL=ernie-3.5-8k
QIANFAN_BASE_URL=
QIANFAN_TOKEN_URL=https://aip.baidubce.com/oauth/2.0/token

# 月之暗面 Kimi (Moonshot)
MOONSHOT_API_KEY=
MOONSHOT_MODEL=moonshot-v1-8k
MOONSHOT_BASE_URL=https://api.moonshot.cn/v1/chat/completions

# Anthropic Claude
CLAUDE_API_KEY=
CLAUDE_MODEL=claude-3-5-sonnet-20241022
CLAUDE_BASE_URL=https://api.anthropic.com/v1/messages

# 自定义 OpenAI 兼容端点（自建网关 / Ollama / vLLM / 其他国产模型）
CUSTOM_API_KEY=
CUSTOM_MODEL=
CUSTOM_BASE_URL=
CUSTOM_SECRET_KEY=

# ESP32 硬件联动（可选加分项）：开发板监听 /remind 的地址
ESP32_ENDPOINT=
