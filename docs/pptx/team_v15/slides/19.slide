', lineHeight: 1.3, margin: 0, marginTop: 0 }}>▪  录入与筛选</Text><Text style={{ fontSize: 15, color: '#4A5568', fontWeight: 'normal', lineHeight: 1.45, margin: 0, marginTop: 4 }}>题干 / 我的答案 / 正确答案三段录入，按掌握状态筛选。</Text></Box><Box style={{ width: 460, flexDirection: 'column', marginTop: 12 }}><Text style={{ fontSize: 18, color: '#1E4FA8', fontWeight: 'bold', lineHeight: 1.3, margin: 0, marginTop: 0 }}>▪  错因与变式</Text><Text style={{ fontSize: 15, color: '#4A5568', fontWeight: 'normal', lineHeight: 1.45, margin: 0, marginTop: 4 }}>分析错因并生成同类变式题，针对薄弱点强化（F10）。</Text></Box><Box style={{ width: 460, flexDirection: 'column', marginTop: 12 }}><Text style={{ fontSize: 18, color: '#1E4FA8', fontWeight: 'bold', lineHeight: 1.3, margin: 0, marginTop: 0 }}>▪  导出归档</Text><Text style={{ fontSize: 15, color: '#4A5568', fontWeight: 'normal', lineHeight: 1.45, margin: 0, marginTop: 4 }}>一键导出 Markdown 错题本（F11）。</Text></Box><Box style={{ width: 190, height: 32, background: '#1E4FA8', borderRadius: 4, flexDirection: 'row', alignItems: 'center', justifyContent: 'center', marginTop: 16 }}><Text style={{ fontSize: 13, color: '#FFFFFF', fontWeight: 'bold', lineHeight: 1.3, margin: 0, marginTop: 0 }}>真实界面  6 / 7</Text></Box></Box></Box></Box><Box style={{ width: '100%', height: 30, flexDirection: 'row', alignItems: 'center', justifyContent: 'space-between' }}><Text style={{ fontSize: 14, color: '#8B97A8', fontWeight: 'normal', lineHeight: 1.3, margin: 0, marginTop: 0 }}>AI 校园学习陪伴助手  ·  课程作业答辩</Text><Text style={{ fontSize: 14, color: '#8B97A8', fontWeight: 'normal', lineHeight: 1.3, margin: 0, marginTop: 0 }}>19 / 28</Text></Box></Slide>